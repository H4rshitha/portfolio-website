# Create a form at https://formspree.io and paste its form ID below (the
# part after /f/ in the endpoint URL it gives you), e.g. VITE_FORMSPREE_ID=abcdwxyz
VITE_FORMSPREE_ID=

# Gemini API key powering the "Copilot" chat (api/copilot.ts). Get one free at
# https://aistudio.google.com/apikey. Server-side only — do NOT prefix with
# VITE_, or Vite will bundle it into client-side JS and leak it publicly.
GEMINI_API_KEY=
